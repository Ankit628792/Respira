# Respira Android Application - Environment Configuration Reference
# Copy or rename this file to `.env` for local configuration.

# Optional Release Keystore Configuration (for building signed release APKs locally)
# KEYSTORE_PATH=release_key.jks
# STORE_PASSWORD=your_store_password
# KEY_PASSWORD=your_key_password

# Optional Firebase App Check Debug Token
# FIREBASE_APPCHECK_DEBUG_TOKEN=
